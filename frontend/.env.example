# Copy to .env.local for local development (`vercel env pull .env.local` fills most of it).

# Supabase: added automatically by the Vercel Supabase integration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Testnet keys from scripts/deploy-testnet.sh (backend/.env)
KEEPER_SECRET=
FAUCET_ISSUER_SECRET=

# Shared secret for /api/cron/tick (any long random string; same value in supabase/cron.sql)
CRON_SECRET=

# Optional
KEEPER_ENABLED=true
FAUCET_AMOUNT=1000
